{
    "Services": {
        "SpecStore": {
            "BaseAddress": "",
            "Path": "api"
        }
    },

    "RabbitMQ": {
        "Host": "",
        "Port": 5672,
        "User": "",
        "Password": "",
        "Consumer": {
            "Queue": "specboard.qdq",
            "Exchange": "specstore.tx",
            "Tag": "SpecBoard.Consumer.Dev",
            "RoutingKeys": [ "specstore.#.#" ]
        }
    },

    "Serilog": {
        "Usings": [ "Serilog.Sinks.Async", "Serilog.Sinks.Console", "Serilog.Sinks.GrafanaLoki" ],
        "MinimumLevel": {
            "Default": "Verbose",
            "Override": {
                "Microsoft": "Information",
                "System": "Warning"
            }
        },
        "Writeto": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "Console",
                            "Args": {
                                "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}",
                                "RestrictedToMinimumLevel": "Warning"
                            }
                        },
                        {
                            "Name": "GrafanaLoki",
                            "Args": {
                                "Uri": "https://loki.mihben.site",
                                "restrictedToMinimumLevel": "Information",
                                "PropertiesAsLabels": [
                                    "Application",
                                    "Environment",
                                    "Module",
                                    "level"
                                ]
                            }
                        }
                    ]
                }
            }
        ],
        "Enrich": [ "FromLogContext" ],
        "Properties": {
            "Application": "SpecBoard",
            "Module": "SpecBoard",
            "Environment": "Production"
        }
    }
}
