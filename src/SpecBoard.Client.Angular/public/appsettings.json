{
  "authorization": {
    "github": {
      "scope": "profile email",
      "redirectUri": "http://localhost:4200/login/callback",
      "responseType": "code",
      "oidc": false
    }
  },

  "logging": {
    "level": "Information",
    "console": {
      "level": "Information",
      "format": "[{timestamp} {level}] {message}"
    },
    "loki": {
      "url": "https://loki.mihben.site/",
      "level": "Verbose",
      "bufferSize": 50,
      "pushInterval": 5000,
      "labels": {
        "Application": "SpecBoard",
        "Service": "Client",
        "Environment": "Production"
      }
    }
  }
}
